# ---------------------------------------------------------------------------
# Local Spark standalone cluster settings.
# This file is read by scripts/start_cluster.sh (bash) AND conf/settings.py (Python),
# so keep it in simple KEY=VALUE form (no spaces around '=').
#
# Default cluster shape (sized for an 8 GB Mac):
#   1 master  +  2 workers, each worker offering 2 cores and 1 GB.
#   Every application gets 2 executors (one per worker), each with 2 cores and a 1 GB heap.
#   => 4 task slots in total (4 tasks can run at the same time).
#
# Approximate real memory use while a job runs:
#   2 executors x ~1.3 GB (1 GB heap + JVM overhead)  ~2.6 GB
#   driver (1 GB heap + overhead) + Python             ~1.5 GB
#   master + 2 workers + History Server (daemons)      ~1.0 GB
#   total                                              ~5 GB
# Close other heavy apps (browsers with many tabs, IDEs) while running experiments.
#
# 16 GB Mac: you may set WORKER_MEMORY=1g, EXECUTOR_MEMORY=2g, DRIVER_MEMORY=2g.
# The docs' memory calculations assume the 1 GB executor values below.
# ---------------------------------------------------------------------------

SPARK_MASTER_HOST=127.0.0.1
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

NUM_WORKERS=2
WORKER_CORES=2
WORKER_MEMORY=3g
# Worker web UIs use 8081, 8082, ... (one per worker)
WORKER_WEBUI_BASE_PORT=8081

# Resources each application asks for
EXECUTOR_CORES=2
EXECUTOR_MEMORY=1g
DRIVER_MEMORY=1g

# Max heap for the master, worker and History Server processes (they hold no data)
SPARK_DAEMON_MEMORY=512m

HISTORY_UI_PORT=18080
