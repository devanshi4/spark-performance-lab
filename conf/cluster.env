# ---------------------------------------------------------------------------
# Local Spark standalone cluster settings.
# This file is read by scripts/start_cluster.sh (bash) AND conf/settings.py (Python),
# so keep it in simple KEY=VALUE form (no spaces around '=').
#
# Default cluster shape:
#   1 master  +  2 workers, each worker offering 2 cores and 3 GB.
#   Every application gets 2 executors (one per worker), each with 2 cores and 2 GB heap.
#   => 4 task slots in total (4 tasks can run at the same time).
#
# If your Mac has 8+ performance cores and 16+ GB RAM you can raise NUM_WORKERS to 3 or 4.
# Keep (NUM_WORKERS * WORKER_MEMORY) well below your physical RAM.
# ---------------------------------------------------------------------------

SPARK_MASTER_HOST=127.0.0.1
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

NUM_WORKERS=2
WORKER_CORES=2
WORKER_MEMORY=3g
# Worker web UIs use 8081, 8082, ... (one per worker)
WORKER_WEBUI_BASE_PORT=8081

# Resources each application asks for
EXECUTOR_CORES=2
EXECUTOR_MEMORY=2g
DRIVER_MEMORY=2g

HISTORY_UI_PORT=18080
